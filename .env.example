# Optional Anthropic provider credentials.
ANTHROPIC_API_KEY=

# Optional anonymous product analytics. Leave the project token empty to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Set to 1/true/yes to force-disable PostHog.
VITE_TELEMETRY_DISABLED=

# Set to 1/true/yes to print one telemetry network diagnostic per app run.
VITE_TELEMETRY_DEBUG=

# Standalone diagnostics only: node --env-file=.env scripts/jev-gateway.mjs
AI_GATEWAY_API_KEY=
# Answer-provider configuration and opt-in standalone OpenRouter diagnostics.
OPENROUTER_API_KEY=
# Production Jev uses only Settings > Jev saved credentials and its enable switch.
# No environment credential or JEV_ROUTER_ENABLED fallback is used by production routing.
